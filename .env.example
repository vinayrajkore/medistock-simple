# Copy these to Render → Environment Variables section
# DO NOT commit your real .env file

# Aiven MySQL credentials (get from Aiven console)
DB_HOST=mysql-xxxx.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=defaultdb

# Required for production static serving
NODE_ENV=production

# Port — Render sets this automatically, don't change
PORT=1000
